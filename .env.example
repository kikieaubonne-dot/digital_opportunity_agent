# Forge AI backend configuration
# Copy this file to server/.env and fill in real values before running the server.

# Port the Express server listens on
PORT=3000

# Comma-free origin allowed to call this API from the browser.
# Use "*" while developing locally. In production, set this to your Forge AI frontend's origin,
# e.g. https://claude.ai (artifacts run inside claude.ai) — see README for caveats.
CORS_ORIGIN=*

# Optional: override the SQLite file location (defaults to server/forge.sqlite3)
# DB_PATH=/absolute/path/to/forge.sqlite3
